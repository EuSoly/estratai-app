# ============================================================================
# EstratAI Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control (it's in .gitignore)

# ============================================================================
# SUPABASE - Database & Authentication
# ============================================================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ============================================================================
# APPLICATION - Frontend Configuration
# ============================================================================
# Application Name (used in UI/branding)
VITE_APP_NAME=EstratAI

# API Base URL (for backend calls, if applicable)
VITE_API_URL=http://localhost:3000

# Frontend URL (for redirects, OAuth callbacks, etc)
VITE_APP_URL=http://localhost:5173

# ============================================================================
# N8N - Webhook Integration for AI Analysis
# ============================================================================
# N8N webhook URL where analysis requests are sent
# Example: https://your-n8n-instance.com/webhook/estratai-analysis
VITE_N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/estratai-analysis

# ============================================================================
# FEATURES & LIMITS
# ============================================================================
# Maximum file size for vault items (in MB)
VITE_MAX_FILE_SIZE_MB=20

# Allowed file types for vault (comma-separated)
VITE_ALLOWED_FILE_TYPES=pdf,docx,pptx,xlsx,csv,txt

# Debounce delay for file search (milliseconds)
VITE_SEARCH_DEBOUNCE_MS=300

# ============================================================================
# LOGGING & DEBUG
# ============================================================================
# Log level: 'error', 'warn', 'info', 'debug'
VITE_LOG_LEVEL=info

# Enable debug mode (shows verbose logs)
VITE_DEBUG=false

# ============================================================================
# THIRD-PARTY SERVICES (FUTURE)
# ============================================================================
# Analytics
VITE_ANALYTICS_ID=

# Error tracking (Sentry)
VITE_SENTRY_DSN=

# Feature flags
VITE_FEATURE_EXPORT_PDF=true
VITE_FEATURE_WEBHOOK=true

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================
# Session timeout (minutes)
VITE_SESSION_TIMEOUT_MINUTES=30

# Token refresh interval (minutes)
VITE_TOKEN_REFRESH_MINUTES=25

# ============================================================================
# DATABASE CONSTRAINTS (mirrors CLAUDE.md)
# ============================================================================
# Plan levels (do not modify - used for validation)
VITE_PLAN_STARTER=Starter
VITE_PLAN_BUSINESS=Business
VITE_PLAN_ENTERPRISE=Enterprise

# ============================================================================
# WOZ ADMIN — TEMPORÁRIO (remover quando n8n estiver ativo)
# ============================================================================
# Seu UUID do Supabase (Authentication → Users → copie o UUID da sua conta)
VITE_ADMIN_USER_ID=
